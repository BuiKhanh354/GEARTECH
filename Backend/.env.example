PORT=5000
MONGODB_URI=mongodb://localhost:27017/geartech
# Generate a long, random secret for every environment.
JWT_SECRET=

# Comma-separated allowed browser origins (required for production web clients).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Cấu hình Giao Hàng Nhanh (GHN) API
# Staging: https://dev-online-gateway.ghn.vn/shiip/public-api
# Production: https://online-gateway.ghn.vn/shiip/public-api
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_ghn_shop_id_here
