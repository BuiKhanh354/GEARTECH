# Địa chỉ backend API của GearTech.
# KHÔNG dùng localhost khi chạy trên điện thoại thật:
# - Android emulator: http://10.0.2.2:5000/api (10.0.2.2 = máy host)
# - Máy thật (cùng Wi-Fi với máy chủ): http://<IP-LAN-máy-chủ>:5000/api
#   Ví dụ: http://192.168.1.10:5000/api
# Xem IP máy chủ bằng lệnh: ipconfig (Windows) / ifconfig (macOS, Linux)
EXPO_PUBLIC_API_URL=http://localhost:5000/api
